      "label": "prod-2026-10-pp4full",
      "env_file": "envs/dsv4-0731-pp4full.json"
    },
    "pp4full-nospark": {
      "label": "prod-2026-10-nospark",
      "env_file": "envs/dsv4-0731-pp4full-nospark.json"
