    "prod-rag-c1",
    "prod-code-c1",
    "prod-standard-c16",
    "prod-standard-c32",
    "prod-standard-c64",
    "prod-standard-c96",
    "prod-standard-c128",
    "prod-standard-c160",
    "prod-chat-c16",
    "prod-chat-c64",
    "prod-chat-c128",
    "prod-rag-c16",
    "prod-rag-c64",
    "prod-rag-c128",
    "prod-code-c16",
    "prod-code-c64",
    "prod-code-c128",
    "prod-longctx-65k-c1",
    "prod-longctx-65k-c8",
